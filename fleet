#!/usr/bin/env python3
"""The task queue and the decision log, from the outside.

    fleet task add --title "Refund reporting" --spec specs/refunds.md \
                   --objective dd-feature-parity --max-cost 3.00
    fleet task list [--status QUEUED] [--queue default]
    fleet task status 7

    fleet decision record --decision REJECTED --reason "..." --issue 1
    fleet decision list [--product P] [--issue N] [--decision REJECTED]
    fleet decision show 3
    fleet decision backfill [--execute]

`decision` records what was chosen and why, and reads back what happened. The
outcome columns it prints do not exist on `decision_log` -- they come from the
`decision_outcomes` view, recomputed from the tasks, runs and issues the
decision cited. There is no flag to set one, here or anywhere.

Connects as fleet_console, which is the only identity that may write the
queue. The runner cannot: there is no INSERT grant on tasks for
fleet_task_runner, and no transition in task_transitions that takes it to a
reviewed state. V1 has no self-generated tasks, and that is a grant rather
than a convention.

`add` reads the acceptance contract from contracts/<repo>.yaml unless
--contract names another file. The contract is checked here for the sake of a
message that names the file, and again by the database, which is what
actually decides: a contract that fails to protect the test suite or the
migrations cannot be stored, so no runner can be pointed at one.

deadly-digital-platform HAS NO contracts/<repo>.yaml, so --contract is
required for it. The file that was there declared platform/app/**,
platform/components/** and platform/lib/** writable -- auth, roles, csrf,
impersonation and billing checkout -- and was deleted with
023_platform_floor.sql rather than narrowed. A default contract is the one
nobody chooses, which makes it the one a task gets by forgetting.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import psycopg
from psycopg.rows import dict_row

from runner import config

STATUS_ORDER = ("QUEUED", "RUNNING", "READY_FOR_REVIEW", "REWORK",
                "FAILED", "REJECTED", "MERGED", "ABANDONED")

DECISIONS = ("APPROVED", "REJECTED", "DEFERRED")

#: Reserved to the backfill by a check constraint. Named here so the CLI can
#: refuse it with a sentence rather than surface a constraint violation.
UNRECORDED = "UNRECORDED"

#: repo -> product, for the backfill. Explicit and small rather than derived:
#: a task names a repository, a decision names a product, and the two happen to
#: correspond today. An unmapped repo stops the backfill instead of defaulting,
#: because a silently-defaulted product is a row filed under a product nobody
#: chose.
REPO_PRODUCT = {
    "deadly-digital-platform": "deadly_digital",
    "fleet": "fleet",
}


def connect():
    return psycopg.connect(config.console_dsn(), row_factory=dict_row)


# ---- add ------------------------------------------------------------------

def cmd_add(args: argparse.Namespace) -> int:
    spec_path = Path(args.spec)
    if not spec_path.exists():
        print(f"no spec at {spec_path}", file=sys.stderr)
        return 2
    spec_md = spec_path.read_text()
    if not spec_md.strip():
        print(f"{spec_path} is empty; a vague spec produces a branch you throw "
              f"away", file=sys.stderr)
        return 2

    contract = config.load_contract(
        args.repo, Path(args.contract) if args.contract else None)

    if args.base_branch and args.base_branch != contract["base_branch"]:
        contract = dict(contract, base_branch=args.base_branch)

    max_cost = args.max_cost or contract.get("max_cost_gbp")
    if max_cost is None:
        print("no --max-cost and none in the contract", file=sys.stderr)
        return 2
    timeout = args.timeout or contract.get("timeout_seconds", 1800)

    with connect() as conn:
        row = conn.execute(
            """
            INSERT INTO tasks (queue, title, spec_md, repo, base_branch,
                               acceptance_contract, priority, objective_ref,
                               max_cost_gbp, timeout_seconds, max_attempts)
            VALUES (%(queue)s, %(title)s, %(spec_md)s, %(repo)s, %(base)s,
                    %(contract)s, %(priority)s, %(objective)s,
                    %(max_cost)s, %(timeout)s, %(max_attempts)s)
            RETURNING id
            """,
            {"queue": args.queue, "title": args.title, "spec_md": spec_md,
             "repo": args.repo, "base": contract["base_branch"],
             "contract": json.dumps(contract), "priority": args.priority,
             "objective": args.objective, "max_cost": max_cost,
             "timeout": timeout, "max_attempts": args.max_attempts},
        ).fetchone()
        conn.commit()

    print(f"task {row['id']} queued: {args.title}")
    print(f"  repo         {args.repo} @ {contract['base_branch']}")
    print(f"  spec         {spec_path} ({len(spec_md.splitlines())} lines)")
    print(f"  budget       £{float(max_cost):.2f}   timeout {timeout}s   "
          f"attempts {args.max_attempts}")
    print(f"  writable     {len(contract['writable_paths'])} globs")
    print(f"  protected    {len(contract['protected_paths'])} globs")
    print(f"  verification {'; '.join(contract['verification'])}")
    return 0


# ---- list -----------------------------------------------------------------

def cmd_list(args: argparse.Namespace) -> int:
    where, params = [], {}
    if args.status:
        where.append("t.status = %(status)s")
        params["status"] = args.status
    if args.queue:
        where.append("t.queue = %(queue)s")
        params["queue"] = args.queue
    clause = ("WHERE " + " AND ".join(where)) if where else ""

    with connect() as conn:
        rows = conn.execute(
            f"""
            -- ONE ROW PER TASK. A plain LEFT JOIN to `runs` returns one row
            -- per RUN, so task 5 -- four runs -- printed four times and the
            -- summary counted 10 tasks where there are 7. The console hit the
            -- same thing and fixed it with this lateral; the CLI kept the join.
            --
            -- `spent` is every run, not the latest. With the latest alone a
            -- task that took four attempts read £4.58 against a real £19.95,
            -- which is the same understatement `decision_outcomes` refuses.
            SELECT t.id, t.status, t.queue, t.priority, t.title, t.repo,
                   t.branch_name, t.attempts, t.max_attempts, t.max_cost_gbp,
                   t.objective_ref, t.created_at,
                   agg.committed_gbp, agg.runs_total
              FROM tasks t
              LEFT JOIN LATERAL (
                  SELECT count(*) AS runs_total,
                         sum(committed_gbp) AS committed_gbp
                    FROM runs WHERE task_id = t.id
              ) agg ON true
              {clause}
             ORDER BY array_position(%(order)s::text[], t.status),
                      t.priority, t.id
            """,
            {**params, "order": list(STATUS_ORDER)},
        ).fetchall()

    if not rows:
        print("no tasks" + (f" with status {args.status}" if args.status else ""))
        return 0

    print(f"{'id':>4}  {'status':<17} {'pri':>4} {'att':>5} {'runs':>5} "
          f"{'£cap':>6} {'£spent':>7}  title")
    for r in rows:
        spent = f"{r['committed_gbp']:.2f}" if r["committed_gbp"] is not None else "-"
        att = f"{r['attempts']}/{r['max_attempts']}"
        print(f"{r['id']:>4}  {r['status']:<17} {r['priority']:>4} {att:>5} "
              f"{r['runs_total']:>5} {r['max_cost_gbp']:>6.2f} {spent:>7}  "
              f"{r['title']}")
        if r["branch_name"]:
            print(f"      {r['branch_name']}")

    counts: dict[str, int] = {}
    for r in rows:
        counts[r["status"]] = counts.get(r["status"], 0) + 1
    print("\n" + "  ".join(f"{s} {counts[s]}"
                           for s in STATUS_ORDER if s in counts))
    return 0


# ---- status ---------------------------------------------------------------

def cmd_status(args: argparse.Namespace) -> int:
    with connect() as conn:
        task = conn.execute(
            "SELECT * FROM tasks WHERE id = %s", (args.task_id,)).fetchone()
        if task is None:
            print(f"no task {args.task_id}", file=sys.stderr)
            return 2
        run = conn.execute(
            "SELECT * FROM runs WHERE task_id = %s ORDER BY id DESC LIMIT 1",
            (args.task_id,)).fetchone()
        steps = conn.execute(
            "SELECT sequence, step_type, actor, created_at, payload"
            "  FROM run_steps WHERE run_id = %s ORDER BY sequence",
            (run["id"],)).fetchall() if run else []
        nxt = conn.execute(
            "SELECT to_status, required_role, note FROM task_transitions"
            " WHERE from_status = %s ORDER BY to_status", (task["status"],)
        ).fetchall()

    c = task["acceptance_contract"]
    print(f"task {task['id']}  {task['status']}")
    print(f"  {task['title']}")
    print(f"  queue        {task['queue']}   priority {task['priority']}")
    print(f"  repo         {task['repo']} @ {task['base_branch']}")
    print(f"  objective    {task['objective_ref'] or '-'}")
    print(f"  budget       £{task['max_cost_gbp']:.2f}   "
          f"timeout {task['timeout_seconds']}s   "
          f"attempts {task['attempts']}/{task['max_attempts']}")
    print(f"  created      {task['created_at']:%Y-%m-%d %H:%M}")
    if task["claimed_at"]:
        print(f"  claimed      {task['claimed_at']:%Y-%m-%d %H:%M}")
    if task["completed_at"]:
        print(f"  completed    {task['completed_at']:%Y-%m-%d %H:%M}")
    print(f"  branch       {task['branch_name'] or '-'}")

    print("\n  contract")
    print(f"    verification   {'; '.join(c['verification'])}")
    print(f"    max diff       {c['max_diff_lines']} lines")
    print(f"    writable       {', '.join(c['writable_paths'])}")
    print(f"    protected      {', '.join(c['protected_paths'])}")

    if run:
        print(f"\n  run {run['id']}  {run['status']}  "
              f"£{run['committed_gbp']} of £{run['spend_limit_gbp']}")
        for s in steps:
            detail = ""
            if s["step_type"] == "VERIFICATION_RUN":
                detail = f"  {s['payload'].get('result', '?')}"
            elif s["step_type"] == "PATCH_PROPOSED":
                detail = f"  {(s['payload'].get('patch_commit_sha') or '')[:12]}"
            print(f"    {s['sequence']:>2}. {s['step_type']:<20} "
                  f"{s['actor']:<12} {s['created_at']:%H:%M:%S}{detail}")
    else:
        print("\n  no run yet")

    print("\n  from here")
    for t in nxt:
        print(f"    -> {t['to_status']:<17} {t['required_role']:<18} {t['note']}")
    if not nxt:
        print("    (terminal)")
    return 0


# ---- decisions ------------------------------------------------------------
#
# `record` writes to decision_log. `list` and `show` read decision_outcomes,
# which is a view: every outcome on the page is recomputed from the task, the
# runs and the issue the decision cited, at the moment it is asked. Nothing
# below writes an outcome because there is no column to write one to.

DECISION_LIST = """
SELECT id, product, subject, decision, reason, decided_by, decided_at,
       origin, confidence, proposal_id, issue_id, task_id,
       task_status, task_outcome, total_cost_gbp, runs_total,
       attempts_to_green, issue_status, issue_outcome
  FROM decision_outcomes
 WHERE (%(product)s::text  IS NULL OR product  = %(product)s)
   AND (%(issue)s::bigint  IS NULL OR issue_id = %(issue)s)
   AND (%(task)s::bigint   IS NULL OR task_id  = %(task)s)
   AND (%(proposal)s::bigint IS NULL OR proposal_id = %(proposal)s)
   AND (%(decision)s::text IS NULL OR decision::text = %(decision)s)
   AND (%(origin)s::text   IS NULL OR origin   = %(origin)s)
 ORDER BY decided_at DESC, id DESC
"""


def _outcome_cells(r: dict) -> tuple[str, str]:
    """The two derived verdicts, as short strings, or an em dash for absent.

    Absent is not the same as bad and must not print like it: a decision that
    cited no task has no task outcome, which is different from a task that
    failed.
    """
    task = r["task_outcome"] or "—"
    if r["task_outcome"] and r["total_cost_gbp"] is not None:
        task = f"{task} £{float(r['total_cost_gbp']):.2f}"
        if r["attempts_to_green"]:
            task += f" /{r['attempts_to_green']}"
    return task, (r["issue_outcome"] or "—")


def cmd_decision_record(args: argparse.Namespace) -> int:
    if args.reason.strip() == UNRECORDED:
        print(f"{UNRECORDED} is reserved to backfilled rows. A decision "
              f"recorded now has a reason; write it.", file=sys.stderr)
        return 2

    with connect() as conn:
        product = args.product
        if product is None and args.issue is not None:
            row = conn.execute("SELECT product FROM issues WHERE id = %s",
                               (args.issue,)).fetchone()
            if row is None:
                print(f"no issue {args.issue}", file=sys.stderr)
                return 2
            product = row["product"]
        if product is None:
            print("no --product, and none could be taken from a cited issue",
                  file=sys.stderr)
            return 2

        # subject and evidence are left NULL/default on purpose: the trigger
        # takes them from whatever is cited. --subject is for the case where
        # nothing is.
        row = conn.execute(
            """
            INSERT INTO decision_log (product, subject, proposal_id, issue_id,
                                      task_id, decision, reason)
            VALUES (%(product)s, %(subject)s, %(proposal)s, %(issue)s,
                    %(task)s, %(decision)s, %(reason)s)
            RETURNING id, subject
            """,
            {"product": product, "subject": args.subject,
             "proposal": args.proposal, "issue": args.issue, "task": args.task,
             "decision": args.decision, "reason": args.reason}).fetchone()
        # SET IN THE SAME TRANSACTION AS THE DECISION, so a pointer without a
        # decision cannot exist even briefly. specs/auto-approval.md §9.17.
        #
        # The composite key refuses a decision that does not cite this task, so
        # the check below is for the MESSAGE: a foreign-key violation names a
        # constraint, and the person typing this needs to be told which of the
        # two arguments they got wrong.
        if args.shipped_task is not None:
            if args.task != args.shipped_task:
                print(f"--shipped-task {args.shipped_task} needs --task "
                      f"{args.shipped_task}: a task may only point at a "
                      f"decision that cites it, and this decision cites "
                      f"{args.task}", file=sys.stderr)
                conn.rollback()
                return 2
            conn.execute(
                "UPDATE tasks SET shipped_by_decision_id = %s WHERE id = %s",
                (row["id"], args.shipped_task))
        conn.commit()
        detail = conn.execute(
            "SELECT * FROM decision_outcomes WHERE id = %s", (row["id"],)
        ).fetchone()

    print(f"decision {row['id']}: {args.decision} — {row['subject']}")
    print(f"  product      {product}")
    cited = [f"{k} {v}" for k, v in (("proposal", args.proposal),
                                     ("issue", args.issue),
                                     ("task", args.task)) if v]
    print(f"  cites        {', '.join(cited) or 'nothing'}")
    print(f"  reason       {args.reason}")
    n = len(detail["evidence"] or [])
    print(f"  evidence     {n} item(s) captured"
          if n else "  evidence     none cited")
    task, issue = _outcome_cells(detail)
    print(f"  outcome      task {task}   issue {issue}   (derived, not stored)")
    return 0


def cmd_decision_list(args: argparse.Namespace) -> int:
    with connect() as conn:
        rows = conn.execute(DECISION_LIST, {
            "product": args.product, "issue": args.issue, "task": args.task,
            "proposal": args.proposal, "decision": args.decision,
            "origin": args.origin}).fetchall()

    if not rows:
        print("no decisions match")
        return 0

    print(f"{'id':>4}  {'when':<11} {'decision':<9} {'product':<15} "
          f"{'task outcome':<26} {'issue':<24}  subject")
    for r in rows:
        task, issue = _outcome_cells(r)
        mark = "~" if r["origin"] == "BACKFILLED" else " "
        print(f"{r['id']:>3}{mark}  {r['decided_at']:%d %b %H:%M} "
              f"{r['decision']:<9} {r['product']:<15} {task:<26} {issue:<24}  "
              f"{r['subject'][:44]}")
        if r["origin"] == "BACKFILLED":
            print(f"      reconstructed from the task row; reason {r['reason']}")

    counts: dict[str, int] = {}
    for r in rows:
        counts[r["decision"]] = counts.get(r["decision"], 0) + 1
    print("\n" + "  ".join(f"{d} {counts[d]}" for d in DECISIONS if d in counts))
    backfilled = sum(1 for r in rows if r["origin"] == "BACKFILLED")
    if backfilled:
        print(f"~ {backfilled} reconstructed, reason not recorded at the time")
    return 0


def cmd_decision_show(args: argparse.Namespace) -> int:
    with connect() as conn:
        d = conn.execute("SELECT * FROM decision_outcomes WHERE id = %s",
                         (args.decision_id,)).fetchone()
    if d is None:
        print(f"no decision {args.decision_id}", file=sys.stderr)
        return 2

    print(f"decision {d['id']}  {d['decision']}")
    print(f"  {d['subject']}")
    print(f"  product      {d['product']}")
    print(f"  decided      {d['decided_at']:%Y-%m-%d %H:%M} by {d['decided_by']}")
    print(f"  reason       {d['reason']}")
    if d["origin"] == "BACKFILLED":
        print("               ^ reconstructed from the database; no reason was "
              "recorded at the time and none has been invented")
    print(f"  provenance   {d['origin']} / {d['confidence']}")
    cited = [f"{k} {d[c]}" for k, c in (("proposal", "proposal_id"),
                                        ("issue", "issue_id"),
                                        ("task", "task_id")) if d[c]]
    print(f"  cites        {', '.join(cited) or 'nothing'}")

    print("\n  evidence, as it stood when the decision was made")
    for item in (d["evidence"] or []):
        print(f"    {json.dumps(item, default=str, sort_keys=True)}")
    if not d["evidence"]:
        print("    none cited")

    # Every line below is recomputed by the view. None of it is stored.
    print("\n  outcome, recomputed now from tasks, runs and issues")
    if d["task_id"]:
        print(f"    task {d['task_id']}     {d['task_status']} "
              f"({d['task_outcome']})")
        print(f"    cost         £{float(d['total_cost_gbp']):.2f} "
              f"over {d['runs_total']} run(s)")
        print(f"    to green     "
              f"{d['attempts_to_green'] or 'not green, so no answer'}")
    else:
        print("    no task cited")
    if d["issue_id"]:
        print(f"    issue {d['issue_id']}    {d['issue_status']} "
              f"({d['issue_outcome']})")
    else:
        print("    no issue cited")
    return 0


def cmd_decision_backfill(args: argparse.Namespace) -> int:
    """One decision per task, reconstructed from what the database holds.

    Every task in `tasks` was a decision to do that work, taken when the row
    was created. That much is recoverable and is all that is: nothing recorded
    who queued it or why, so `decided_by` and `reason` are the reserved
    sentinel rather than a plausible sentence, and every row is marked
    BACKFILLED / INFERRED.

    `decided_at` is `tasks.created_at` -- the moment the work was chosen, not
    the moment it was merged. The merge is an OUTCOME, and the view derives it.

    Idempotent: a task that already has a backfilled decision is skipped, so a
    second run adds nothing.
    """
    with connect() as conn:
        rows = conn.execute(
            """
            SELECT t.id, t.repo, t.title, t.created_at, t.objective_ref,
                   t.status, t.max_cost_gbp
              FROM tasks t
             WHERE NOT EXISTS (SELECT 1 FROM decision_log d
                                WHERE d.task_id = t.id AND d.origin = 'BACKFILLED')
             ORDER BY t.id
            """).fetchall()

        unmapped = sorted({r["repo"] for r in rows if r["repo"] not in REPO_PRODUCT})
        if unmapped:
            print(f"no product mapping for repo(s): {', '.join(unmapped)}. Add "
                  f"them to REPO_PRODUCT rather than letting them default.",
                  file=sys.stderr)
            return 2

        if not rows:
            print("nothing to backfill; every task already has one")
            return 0

        for r in rows:
            print(f"  task {r['id']:>3}  {REPO_PRODUCT[r['repo']]:<15} "
                  f"{r['created_at']:%d %b %H:%M}  {r['title'][:52]}")

        if not args.execute:
            print(f"\n{len(rows)} decisions would be written. Dry run; pass "
                  f"--execute to write them.")
            return 0

        written = 0
        for r in rows:
            # evidence stays empty. A synthesised evidence object would be an
            # invention dressed as a citation, and the task_id already points
            # at everything that was actually recorded.
            conn.execute(
                """
                INSERT INTO decision_log (product, subject, task_id, decision,
                                          reason, decided_by, decided_at,
                                          origin, confidence)
                VALUES (%(product)s, %(subject)s, %(task)s, 'APPROVED',
                        %(unrecorded)s, %(unrecorded)s, %(at)s,
                        'BACKFILLED', 'INFERRED')
                """,
                {"product": REPO_PRODUCT[r["repo"]], "subject": r["title"],
                 "task": r["id"], "at": r["created_at"],
                 "unrecorded": UNRECORDED})
            written += 1
        conn.commit()

    print(f"\n{written} decisions backfilled, all marked BACKFILLED/INFERRED "
          f"with reason {UNRECORDED}.")
    return 0


def cmd_candidates_undo(args) -> int:
    """Undo one approval. The implementation is console/undo.py; this is the
    name the brief prints, so the two must not drift."""
    from console import undo
    try:
        return undo.main(
            [str(args.decision_id)]
            + (["--reason", args.reason] if args.reason else [])
            + (["--dry-run"] if args.dry_run else []))
    except undo.UndoRefused as exc:
        print(f"REFUSED: {exc}", file=sys.stderr)
        return 1


# ---- entry ----------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="fleet", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="group", required=True)
    task = sub.add_parser("task", help="the task queue").add_subparsers(
        dest="command", required=True)

    a = task.add_parser("add", help="queue a task")
    a.add_argument("--title", required=True)
    a.add_argument("--spec", required=True, help="path to the spec markdown")
    a.add_argument("--repo", default="deadly-digital-platform")
    a.add_argument("--contract",
                   help="contract yaml (default: contracts/<repo>.yaml; "
                        "deadly-digital-platform has none, so name one)")
    a.add_argument("--base-branch", help="override the contract's base branch")
    a.add_argument("--objective", help="objective id from the quarter's file")
    a.add_argument("--max-cost", type=float, help="£ ceiling for this task")
    a.add_argument("--timeout", type=int, help="wall-clock seconds, max 3600")
    a.add_argument("--priority", type=int, default=100, help="lower is sooner")
    a.add_argument("--queue", default="default")
    a.add_argument("--max-attempts", type=int, default=1)
    a.set_defaults(fn=cmd_add)

    l = task.add_parser("list", help="what is queued and what is waiting on you")
    l.add_argument("--status", choices=STATUS_ORDER)
    l.add_argument("--queue")
    l.set_defaults(fn=cmd_list)

    s = task.add_parser("status", help="one task in full")
    s.add_argument("task_id", type=int)
    s.set_defaults(fn=cmd_status)

    dec = sub.add_parser("decision", help="the decision log").add_subparsers(
        dest="command", required=True)

    r = dec.add_parser("record", help="record one decision and why")
    r.add_argument("--decision", required=True, choices=DECISIONS)
    r.add_argument("--reason", required=True,
                   help="why. Required on every decision, rejections and "
                        "deferrals included -- a rejection with no reason is "
                        "the record this log exists to keep")
    r.add_argument("--product", help="defaults to a cited issue's product")
    r.add_argument("--proposal", type=int, help="proposals.id this decides")
    r.add_argument("--issue", type=int, help="issues.id this cites")
    r.add_argument("--task", type=int, help="tasks.id this authorised")
    r.add_argument("--subject", help="one line on what was proposed. Taken "
                                     "from the cited row when there is one")
    r.add_argument("--shipped-task", type=int, metavar="N",
                   help="record that THIS decision is what put task N's work "
                        "on its base branch, and point the task at it. Requires "
                        "--task N: the pointer may only name a decision that "
                        "cites the task, and the database enforces that")
    r.set_defaults(fn=cmd_decision_record)

    dl = dec.add_parser("list", help="decisions with their derived outcomes")
    dl.add_argument("--product")
    dl.add_argument("--issue", type=int)
    dl.add_argument("--task", type=int)
    dl.add_argument("--proposal", type=int)
    dl.add_argument("--decision", choices=DECISIONS)
    dl.add_argument("--origin", choices=("RECORDED", "BACKFILLED"))
    dl.set_defaults(fn=cmd_decision_list)

    ds = dec.add_parser("show", help="one decision, its evidence and outcome")
    ds.add_argument("decision_id", type=int)
    ds.set_defaults(fn=cmd_decision_show)

    db = dec.add_parser("backfill",
                        help="one decision per existing task, reconstructed")
    db.add_argument("--execute", action="store_true",
                    help="write them; without this it is a dry run")
    db.set_defaults(fn=cmd_decision_backfill)

    # `candidates undo` exists because the morning brief PRINTS it beside every
    # unattended approval, and a copy-paste undo that is not a real command is
    # worse than no line at all -- it is read as a safety net right up until
    # somebody needs it. specs/auto-approval.md §5, correction 4.
    cand = sub.add_parser(
        "candidates", help="the approval surface, from the outside"
    ).add_subparsers(dest="command", required=True)
    cu = cand.add_parser(
        "undo", help="abandon an approval's unclaimed spec tasks and return "
                     "its candidates to PENDING")
    cu.add_argument("decision_id", type=int)
    cu.add_argument("--reason", help="why; recorded on the follow-up decision")
    cu.add_argument("--dry-run", action="store_true")
    cu.set_defaults(fn=cmd_candidates_undo)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except psycopg.errors.RaiseException as exc:
        print(str(exc).split("\n")[0], file=sys.stderr)
        return 1
    except (psycopg.errors.CheckViolation, psycopg.errors.InsufficientPrivilege) as exc:
        print(str(exc).split("\n")[0], file=sys.stderr)
        return 1
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
