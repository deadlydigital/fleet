[Unit]
Description=Fleet observation cycle
Documentation=file:/home/ubuntu/fleet/README.md
After=network-online.target
Wants=network-online.target

# Every fleet unit reports its own failure. Without this a unit that fails
# to start is silent: systemd knows, the brief cannot say so, and the
# failure waits for somebody to run a sweep. See
# systemd/fleet-unit-failed@.service.
OnFailure=fleet-unit-failed@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fleet
ExecStart=/home/ubuntu/fleet/.venv/bin/python /home/ubuntu/fleet/run_cycle.py
# Exit 2 means a reading was stale and part of the answer is missing. That is
# a result, not a failure: the cycle ran, said what it could, and said what it
# could not. systemd should not paint it red.
SuccessExitStatus=0 2
TimeoutStartSec=300
SyslogIdentifier=fleet-proposer-cycle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
