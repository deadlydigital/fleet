# Rank the open candidates and tick the top of the list, with nobody watching.
#
# specs/auto-approval.md §2.6. A SEPARATE unit from fleet-runner AND from
# fleet-automerge, on the same argument fleet-automerge.service makes: stopping
# unattended approval must not mean stopping the runner or the merge, and at
# 3am on a bad night the thing you want to stop is one of the three.
#
# WHAT THIS CAN COST, STATED IN THE UNIT because this is where somebody looks
# when they are deciding whether to leave it running: it creates DRAFT-SPEC
# tasks and nothing else. draft_spec is on console/automerge.py's
# NEVER_UNATTENDED, so the output is markdown on a local branch that no
# auto-merge will touch. A wrong ranking every night for a week costs GBP 14 at
# the pace in force and lands nothing in either repository.
#
# AND IT IS SCOPED. specs/auto-approval.md §0: this is reversed once Deadly
# Digital has a customer. If it has one and this timer is still enabled, that
# is the bug.
[Unit]
Description=Fleet auto-approval (unattended)
Documentation=file:/home/ubuntu/fleet/specs/auto-approval.md
After=network-online.target
Wants=network-online.target
# Every fleet unit reports its own failure. See systemd/fleet-unit-failed@.service.
OnFailure=fleet-unit-failed@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fleet
# LIVE since 10 Sep 2026. `--dry-run` was here for two nights and came out
# deliberately; what follows is the argument, because a flag that is absent
# looks like a flag nobody thought about.
#
# WHAT THE DRY RUNS ACTUALLY ESTABLISHED, AND IT IS NOT WHAT THEY LOOKED LIKE.
# Both nights "approved" one candidate and read as boring. They were not: c21
# and c22 were being held by the overlap gate behind queued task 49, and those
# two are the rows that tie with c20 on every key. When task 49 failed at
# 02:07 on 10 Sep the tie appeared immediately. So the dry runs were reporting
# an order produced by an unrelated task's queue state, and reading more of
# them would have kept reporting it.
#
# That is the case for stopping: blind observation was worth less than one real
# night that leaves a row. specs/auto-approval.md §9.5 is why a refused night
# now records itself -- a dry run writes NOTHING, deliberately, so the thing
# worth reading in the morning could not exist until the flag came off.
#
# WHAT A WRONG NIGHT COSTS, RE-CHECKED RATHER THAN QUOTED. The pace is 1
# (fleet_autoapprove_per_night()). One draft-spec task at GBP 2.00 against
# GBP 139.68 remaining, with the unattended 60% line at GBP 76.48. draft_spec
# is on console/automerge.py's NEVER_UNATTENDED, and that module says of it:
# "This is not the contract's flag -- no flag makes it eligible." So the output
# is markdown on a local branch that no auto-merge will touch, and reverting a
# night is `./fleet candidates undo <decision>`, printed in the brief.
#
# §0'S REVERSAL CONDITION IS UNCHANGED AND IS NOT A DATE. If Deadly Digital has
# a customer and this timer is still enabled, that is the bug.
ExecStart=/home/ubuntu/fleet/.venv/bin/python /home/ubuntu/fleet/run_autoapprove.py

# It reads two checkouts to re-execute the probes and writes only to the
# database. Nothing here needs to write a file, so nothing here may.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M
