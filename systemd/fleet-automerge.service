# Merge what may be merged with nobody watching.
#
# specs/unattended-operation.md §6.1. A SEPARATE unit from fleet-runner on
# purpose: stopping unattended merging must not mean stopping the runner, and
# at 3am on a bad night the thing you want to stop is this one.
#
# It runs the same three steps the Accept route runs -- preflight, then
# re-verification, then merge_and_push -- and adds ONE question between the
# second and third: may this task merge with nobody watching? It removes
# nothing. Every refusal Accept makes, this makes.
[Unit]
Description=Fleet auto-merge (unattended)
After=network-online.target
Wants=network-online.target
# Every fleet unit reports its own failure. See systemd/fleet-unit-failed@.service.
OnFailure=fleet-unit-failed@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fleet
# LIVE SINCE 10 SEP 2026. It ran --dry-run until then, on
# specs/unattended-operation.md §9: nothing after step 2 runs unattended until
# the steps before it have run attended for a few nights.
#
# The flag came out in the same change that took `draft_spec` off
# console/automerge.py's NEVER_UNATTENDED, because the two together are what
# closes the loop -- a live sweep that still refuses every draft would merge
# code tasks whose specs no timer can reach, and the chain would stall in the
# same place with the risk already taken.
#
# `run_automerge.py --dry-run` is still the honest way to watch a rule change:
# it considers every waiting task, applies every rule, and merges nothing. Run
# it by hand after editing console/automerge.py; do not put the flag back here
# without saying why in this comment.
ExecStart=/home/ubuntu/fleet/.venv/bin/python /home/ubuntu/fleet/run_automerge.py

# It merges and pushes, so it needs what the console needs and nothing more:
# a trial clone in its own PrivateTmp, and no write to any checkout.
# See console/merge.py -- the merge is published from the trial, not made here.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# THE VERIFICATION MEMORY CEILING, AND IT IS THE SAME NUMBER IN THREE UNITS.
#
# fleet-runner, fleet-console and fleet-automerge all run THE SAME CONTRACT
# VERIFICATION COMMANDS against the same branch, and they exist to agree about
# whether it passes. Until 11 Sep 2026 they carried three different answers to
# "how much memory may that take" -- runner unset (infinity), console 2G,
# automerge 512M -- so a branch could pass in the runner and be reported as
# failing by the accept path for no reason connected to the branch. It did:
# task 53's tsc exited 134 under automerge's 512M and was rendered as "the
# branch verifies on its own and FAILS when merged into main as it stands
# now."
#
# WHAT THE NUMBER IS MEASURED AGAINST: the heaviest verification sequence any
# contract declares, run whole, inside this confinement. Not a guess, not the
# worst single command, and not the host's size. Measured 11 Sep 2026 by
# re-verifying one task per contract class under these exact properties and
# reading the cgroup's own memory.peak:
#
#   dd-analytics-frontend   tsc + vitest + bite check     961 MiB   113s
#   deadly-digital-platform-api   compileall + ruff + 31-file pytest   274 MiB   236s
#   draft-spec              draft_spec_shape.py            46 MiB     0.4s
#
# 2G is 2.1x the heaviest. The host has 7.8G, and the runner window
# (02:00-04:00) overlaps automerge (03:30), so two of these must fit at once.
#
# RE-MEASURE WHEN A CONTRACT GAINS A CHECK, and MemoryAccounting=yes below is
# what makes that possible from a real run rather than from another probe:
# `systemctl show <unit> -p MemoryPeak`. A ceiling nobody can re-measure is a
# number that was right once.
#
# tests/test_unit_ceilings.py asserts these three stay equal and stay above
# the measured peak recorded there. Editing one of them alone fails that test.
MemoryAccounting=yes
MemoryMax=2G
