[Unit]
Description=fleet auto-merge, nightly
Documentation=file:/home/ubuntu/fleet/specs/unattended-operation.md

[Timer]
Unit=fleet-automerge.service
# After the runner's 02:00 slot, so a task built tonight is considered
# tonight. Not before it: merging yesterday's work while tonight's is still
# running would report a quiet night that had not happened yet.
OnCalendar=*-*-* 03:30:00
AccuracySec=1m
# NOT Persistent. A missed slot is a night nobody merged, which is the safe
# direction, and the next slot considers the same tasks anyway.
Persistent=false

[Install]
WantedBy=timers.target
