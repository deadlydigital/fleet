# The fleet console. Unlike the detector timers in this directory, this one IS
# installed and enabled: Caddy proxies a public hostname to it, and a proxy
# pointing at a process that did not survive the last reboot is a 502 at 8am
# on the morning you most wanted the page.
#
# Binds loopback and nothing else. Authentication belongs to Caddy; see the
# fleet.deadlydigital.io block in /etc/caddy/Caddyfile. The app has no login of
# its own by design, so binding anything other than 127.0.0.1 would publish
# operational state to the internet.
[Unit]
Description=Fleet console (read-only web view over the fleet database)
After=network-online.target
Wants=network-online.target

# Every fleet unit reports its own failure. Without this a unit that fails
# to start is silent: systemd knows, the brief cannot say so, and the
# failure waits for somebody to run a sweep. See
# systemd/fleet-unit-failed@.service.
OnFailure=fleet-unit-failed@%n.service

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fleet
ExecStart=/home/ubuntu/fleet/.venv/bin/python run_console.py --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5s

# It reads one database as a role that holds SELECT and nothing else, and it
# reads git repositories on disk to render diffs.
#
# THERE IS NO ReadWritePaths, AND THAT IS THE POINT.
#
# It writes in exactly three places, none of them a checkout: the fleet
# database as fleet_console, from the accept and reject routes; a git remote,
# when accept publishes a merge; and its own PrivateTmp. Every checkout on
# this filesystem is READ-ONLY to it, including the platform repository and
# the fleet repository it is itself running from.
#
# Until 9 Sep 2026 this named /home/ubuntu/deadly-digital-platform, because
# accept ran `git merge` in that checkout. That grant was the reason a task in
# any OTHER repository could not be accepted at all -- task 22 failed with
# "cannot lock ref 'ORIG_HEAD': Read-only file system" -- and widening it to
# fix that would have handed the console write access to `.git/hooks` in the
# repository its own code is served from, which is arbitrary code execution.
#
# The merge is now built and verified in a throwaway clone under PrivateTmp
# and pushed from there, so the grant bought nothing and was removed rather
# than widened. Verified by running the whole accept path, up to the push,
# under this unit's confinement with no ReadWritePaths at all.
# See console/merge.py and specs/merge-outside-the-checkout.md.
ProtectSystem=strict
ProtectHome=read-only
# Kept for the rest of /tmp. It is no longer what makes the trial writable --
# the trial moved to /home/ubuntu/.fleet-trials on 16 Sep 2026 precisely
# BECAUSE this setting hid the trial from the docker daemon. See the grant
# below and console/config.py.
#
# It is NOT, on its own, what makes Accept work, and the comment here used to
# imply that it was. A trial built as a linked worktree writes into the
# repository it links from as well as into its own directory, so this setting
# fixed the write that was never the problem while leaving the one that was.
# The trial is a clone for that reason; see console/reverify.py. The tests
# below the sandbox comment in tests/test_console_decide.py now run the real
# operation under this unit's real confinement rather than a mkdir that only
# ever exercised the half that worked.
PrivateTmp=true

# THE ONE ReadWritePaths, ADDED 16 Sep 2026, AND THE ARGUMENT ABOVE IS ANSWERED
# RATHER THAN IGNORED.
#
# Everything above stays true: this unit writes the fleet database, a git
# remote, and its trial. What changed is WHERE the trial can live. It was
# /tmp/fleet-console-trials, writable because PrivateTmp gives this unit its
# own /tmp -- and THE DOCKER DAEMON IS NOT IN THAT NAMESPACE. The test stack's
# compose file bind-mounts ./mocks/listmonk relatively, the daemon resolved it
# against the HOST /tmp, and created the path as root at the trial's location.
# That poisoned the path for every non-root caller and handed WireMock an empty
# directory. See console/config.py, which carries the measurements.
#
# WHY THIS IS NOT THE GRANT THAT WAS REMOVED ON 9 Sep. That one named
# /home/ubuntu/deadly-digital-platform -- A CHECKOUT, with a .git/hooks this
# unit's own code is served next to, which is arbitrary code execution. This
# names a directory that exists only to hold throwaway clones, contains no
# checkout, is on no import path, and is written by nothing but
# create_trial_clone. Every checkout on this filesystem is still READ-ONLY to
# this unit, including the platform repository and the fleet repository it runs
# from. The 9 Sep sentence -- "the grant bought nothing and was removed rather
# than widened" -- is still the rule; this buys something specific and is the
# narrowest path that buys it.
#
# IT IS STILL A GRANT, AND A NARROWER ONE EXISTS. `StateDirectory=fleet-trials`
# would put the trials in /var/lib/fleet-trials, created and owned by systemd
# for this unit, with no ReadWritePaths line at all and nothing under /home
# reachable. That is the better posture and it was not taken here only because
# it moves the directory for every caller at once, including by-hand runs. If
# this file ever grows a second ReadWritePaths, take that instead of a third.
#
# The directory must EXIST before the unit starts: systemd fails a unit whose
# ReadWritePaths names a missing path. `install -d -o ubuntu -g ubuntu -m 755
# /home/ubuntu/.fleet-trials`.
ReadWritePaths=/home/ubuntu/.fleet-trials
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 2G since 10 Sep 2026, MEASURED rather than chosen, and it is not a web
# app's number because this is not only a web app.
#
# STILL 2G ON 11 SEP 2026, AND NOW IT IS THE SAME NUMBER AS THE OTHER TWO.
# fleet-runner and fleet-automerge carried infinity and 512M respectively
# until then, so the three units that run the same verification and exist to
# agree about it held three different answers. Re-measured whole-sequence and
# inside this confinement, by reading the cgroup's memory.peak:
#
#   dd-analytics-frontend   tsc + vitest + bite check                961 MiB
#   deadly-digital-platform-api   compileall + ruff + 31-file pytest 274 MiB
#   draft-spec              draft_spec_shape.py                       46 MiB
#
# The 709 MiB below is tsc alone and remains correct; 961 MiB is the sequence,
# which is what a ceiling has to hold. 2G is 2.1x it. MemoryAccounting=yes is
# on all three now so the next measurement comes from a real run.
# tests/test_unit_ceilings.py keeps the three equal. The accept route re-runs
# THE CONTRACT'S OWN VERIFICATION in a trial clone -- that is the whole point
# of it -- and for the frontend contract that is tsc and a 319-test vitest run.
#
#   tsc --noEmit          peak RSS 709 MiB, 13s
#   vitest run            peak RSS 352 MiB per process, 73s, plus a worker pool
#
# At 512M tsc aborted with SIGABRT (exit 134, V8's out-of-memory abort) and the
# console reported "the branch verifies on its own and FAILS when merged into
# main as it stands now. The base moved under it." -- a confident, specific,
# entirely wrong sentence. The base had not moved: main was the branch's own
# merge base. Nothing distinguishes a check that failed from a check the
# sandbox killed.
#
# fleet-runner.service runs the same commands with MemoryMax=infinity, so the
# two paths that must agree about whether a branch passes were never given the
# same room to answer in.
#
# Bounded rather than infinity: this process also serves HTTP, and an unbounded
# web service is a worse failure than a capped one. 2G is ~2.9x the measured
# tsc peak with room for vitest's workers, on a host with 7.8G.
MemoryAccounting=yes
MemoryMax=2G

[Install]
WantedBy=multi-user.target
