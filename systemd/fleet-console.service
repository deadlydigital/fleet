# The fleet console. Unlike the detector timers in this directory, this one IS
# installed and enabled: Caddy proxies a public hostname to it, and a proxy
# pointing at a process that did not survive the last reboot is a 502 at 8am
# on the morning you most wanted the page.
#
# Binds loopback and nothing else. Authentication belongs to Caddy; see the
# fleet.deadlydigital.io block in /etc/caddy/Caddyfile. The app has no login of
# its own by design, so binding anything other than 127.0.0.1 would publish
# operational state to the internet.
[Unit]
Description=Fleet console (read-only web view over the fleet database)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fleet
ExecStart=/home/ubuntu/fleet/.venv/bin/python run_console.py --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5s

# It reads one database as a role that holds SELECT and nothing else, and it
# reads git repositories on disk to render diffs.
#
# It writes in exactly two places: the fleet database, as fleet_console, from
# the accept and reject routes; and the platform checkout, when accept merges
# a branch. Everything else on this filesystem is read-only to it.
#
# ReadWritePaths names the platform repository and nothing else -- not
# /home/ubuntu, not the fleet repo it is running from. A merge writes inside
# .git (refs, ORIG_HEAD, the index) and to the working tree, and that is the
# whole of what it needs.
#
# Without this the merge fails with "cannot lock ref 'ORIG_HEAD': Read-only
# file system", which is what happened the first time accept was pressed on a
# task that needed a real merge. The failure was safe -- nothing was recorded
# and the checkout was left clean -- but it was reported as a conflict, which
# it was not. See console/merge.py.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/deadly-digital-platform
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=multi-user.target
