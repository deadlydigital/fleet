# The fleet console. Unlike the detector timers in this directory, this one IS
# installed and enabled: Caddy proxies a public hostname to it, and a proxy
# pointing at a process that did not survive the last reboot is a 502 at 8am
# on the morning you most wanted the page.
#
# Binds loopback and nothing else. Authentication belongs to Caddy; see the
# fleet.deadlydigital.io block in /etc/caddy/Caddyfile. The app has no login of
# its own by design, so binding anything other than 127.0.0.1 would publish
# operational state to the internet.
[Unit]
Description=Fleet console (read-only web view over the fleet database)
After=network-online.target
Wants=network-online.target

# Every fleet unit reports its own failure. Without this a unit that fails
# to start is silent: systemd knows, the brief cannot say so, and the
# failure waits for somebody to run a sweep. See
# systemd/fleet-unit-failed@.service.
OnFailure=fleet-unit-failed@%n.service

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fleet
ExecStart=/home/ubuntu/fleet/.venv/bin/python run_console.py --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5s

# It reads one database as a role that holds SELECT and nothing else, and it
# reads git repositories on disk to render diffs.
#
# THERE IS NO ReadWritePaths, AND THAT IS THE POINT.
#
# It writes in exactly three places, none of them a checkout: the fleet
# database as fleet_console, from the accept and reject routes; a git remote,
# when accept publishes a merge; and its own PrivateTmp. Every checkout on
# this filesystem is READ-ONLY to it, including the platform repository and
# the fleet repository it is itself running from.
#
# Until 9 Sep 2026 this named /home/ubuntu/deadly-digital-platform, because
# accept ran `git merge` in that checkout. That grant was the reason a task in
# any OTHER repository could not be accepted at all -- task 22 failed with
# "cannot lock ref 'ORIG_HEAD': Read-only file system" -- and widening it to
# fix that would have handed the console write access to `.git/hooks` in the
# repository its own code is served from, which is arbitrary code execution.
#
# The merge is now built and verified in a throwaway clone under PrivateTmp
# and pushed from there, so the grant bought nothing and was removed rather
# than widened. Verified by running the whole accept path, up to the push,
# under this unit's confinement with no ReadWritePaths at all.
# See console/merge.py and specs/merge-outside-the-checkout.md.
ProtectSystem=strict
ProtectHome=read-only
# Load-bearing for Accept: re-verification builds its trial clone in
# /tmp/fleet-console-trials, which is writable only because this is private.
# Removing it breaks Accept.
#
# It is NOT, on its own, what makes Accept work, and the comment here used to
# imply that it was. A trial built as a linked worktree writes into the
# repository it links from as well as into its own directory, so this setting
# fixed the write that was never the problem while leaving the one that was.
# The trial is a clone for that reason; see console/reverify.py. The tests
# below the sandbox comment in tests/test_console_decide.py now run the real
# operation under this unit's real confinement rather than a mkdir that only
# ever exercised the half that worked.
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=multi-user.target
