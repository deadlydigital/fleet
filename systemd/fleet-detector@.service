[Unit]
Description=Fleet detector %i
Documentation=file:/home/ubuntu/fleet/README.md
After=network-online.target
Wants=network-online.target

# Every fleet unit reports its own failure. Without this a unit that fails
# to start is silent: systemd knows, the brief cannot say so, and the
# failure waits for somebody to run a sweep. See
# systemd/fleet-unit-failed@.service.
OnFailure=fleet-unit-failed@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fleet
ExecStart=/home/ubuntu/fleet/.venv/bin/python /home/ubuntu/fleet/run_detector.py %i
# Longer than execution_timeout in detector_registry (2 minutes), so systemd
# killing the process is a last resort and the database's own reclaim path
# stays the one that decides a run is stale.
TimeoutStartSec=600
SyslogIdentifier=fleet-detector-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
